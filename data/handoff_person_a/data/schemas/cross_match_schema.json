{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AFTERLIGHT Cross-Reference & Observation Matching Record",
  "type": "object",
  "required": [
    "status",
    "query",
    "scientific_match_verdict",
    "target_coordinates",
    "provenance"
  ],
  "properties": {
    "status": { "type": "string" },
    "query": {
      "type": "object",
      "required": ["identifier", "category"],
      "properties": {
        "identifier": { "type": "string" },
        "category": { "type": "string" },
        "target_timestamp_utc": { "type": ["string", "null"] }
      }
    },
    "scientific_match_verdict": {
      "type": "object",
      "required": ["coverage_status", "detection_label", "scientific_rule"],
      "properties": {
        "coverage_status": {
          "type": "string",
          "enum": ["COVERAGE_AVAILABLE", "NO_COVERAGE"]
        },
        "detection_label": {
          "type": "string",
          "enum": ["IMAGE DETECTION", "POSSIBLE MATCH", "NO_COVERAGE"]
        },
        "scientific_rule": { "type": "string" }
      }
    },
    "target_coordinates": {
      "type": "object",
      "properties": {
        "ra_deg": { "type": ["number", "null"] },
        "dec_deg": { "type": ["number", "null"] },
        "coordinate_type": {
          "type": "string",
          "enum": ["PREDICTED", "CATALOGUE MATCH", "UNKNOWN"]
        }
      }
    },
    "spherex_observations": {
      "type": "object",
      "properties": {
        "match_count": { "type": "integer" },
        "observations": { "type": "array" }
      }
    },
    "image_evidence": {
      "type": ["object", "null"],
      "properties": {
        "fits_filename": { "type": "string" },
        "is_inside_pixel_bounds": { "type": "boolean" },
        "pixel_x": { "type": "number" },
        "pixel_y": { "type": "number" },
        "pixel_flux_mjy_sr": { "type": "number" },
        "estimated_snr": { "type": "number" },
        "is_point_source_detected": { "type": "boolean" }
      }
    },
    "provenance": { "$ref": "provenance_schema.json" }
  }
}
