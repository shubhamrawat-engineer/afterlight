{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AFTERLIGHT Unified Provenance Record",
  "type": "object",
  "required": [
    "source_name",
    "retrieval_timestamp_utc",
    "retrieval_status"
  ],
  "properties": {
    "source_name": { "type": "string" },
    "source_version": { "type": ["string", "null"] },
    "source_url": { "type": "string" },
    "retrieval_timestamp_utc": { "type": "string" },
    "retrieval_status": {
      "type": "string",
      "enum": ["LIVE", "CACHED", "LIVE_DOWNLOAD", "CACHED_REUSE"]
    },
    "checksum_sha256": { "type": ["string", "null"] }
  }
}
