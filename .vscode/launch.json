{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Run AFTERLIGHT API",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONUTF8": "1"
            }
        },
        {
            "name": "Python: Run pytest Test Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "test_suite.py",
                "-v"
            ],
            "console": "integratedTerminal"
        }
    ]
}
